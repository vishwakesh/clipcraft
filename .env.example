# REQUIRED: create a key at https://build.nvidia.com/settings and paste it here.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Change this to a model available in your NVIDIA API Catalog account if needed.
NVIDIA_MODEL=openai/gpt-oss-20b

# Start with 'base' for a faster initial test; 'small' is usually more accurate but heavier.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Use an absolute path for deployment, e.g. /opt/minecraft-clipper/data.
WORK_DIR=./data
MAX_VIDEO_SECONDS=14400
MAX_CLIP_COUNT=15
FFMPEG_PRESET=veryfast
LOG_LEVEL=INFO

# Recommended before exposing the app beyond localhost. Leave both empty for local-only development.
# The browser will use HTTP Basic Auth when both are set. Put the app behind HTTPS for remote use.
APP_USERNAME=
APP_PASSWORD=
